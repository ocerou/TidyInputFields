{
  "name": "tidyinputfields",
  "version": "0.0.0",
  "description": "Tidy, dependency-free form input components — plain JavaScript and CSS.",
  "license": "MIT",
  "author": "Olivier CEROU",
  "type": "module",
  "keywords": [
    "form",
    "input",
    "components",
    "vanilla",
    "web-components",
    "bootstrap",
    "datepicker",
    "select",
    "i18n",
    "accessible",
    "rich-text-editor"
  ],
  "homepage": "https://github.com/ocerou/TidyInputFields#readme",
  "bugs": {
    "url": "https://github.com/ocerou/TidyInputFields/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ocerou/TidyInputFields.git"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/tidyinputfields.js",
  "module": "./dist/tidyinputfields.js",
  "types": "./dist/types/index.d.ts",
  "unpkg": "./dist/tidyinputfields.min.js",
  "jsdelivr": "./dist/tidyinputfields.min.js",
  "style": "./dist/tidyinputfields.css",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/tidyinputfields.js"
    },
    "./react": {
      "types": "./dist/types/react/index.d.ts",
      "import": "./dist/react.js"
    },
    "./rich-text": {
      "types": "./dist/types/rich-text/index.d.ts",
      "import": "./dist/rich-text.js"
    },
    "./rich-text/css": "./dist/rich-text.css",
    "./rich-text.css": "./dist/rich-text.css",
    "./css": "./dist/tidyinputfields.css",
    "./tidyinputfields.css": "./dist/tidyinputfields.css",
    "./locales/*": "./dist/locales/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.react.config.ts && vite build --config vite.rich.config.ts && tsc -p tsconfig.build.json && node scripts/build-locales.ts",
    "lint": "oxlint && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm test && npm run build",
    "docs": "vite --config vite.site.config.ts",
    "docs:build": "vite build --config vite.site.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tiptap/core": "2.27.3",
    "@tiptap/extension-bubble-menu": "2.27.3",
    "@tiptap/extension-color": "2.27.3",
    "@tiptap/extension-emoji": "2.27.3",
    "@tiptap/extension-font-family": "2.27.3",
    "@tiptap/extension-highlight": "2.27.3",
    "@tiptap/extension-image": "2.27.3",
    "@tiptap/extension-link": "2.27.3",
    "@tiptap/extension-mention": "2.27.3",
    "@tiptap/extension-placeholder": "2.27.3",
    "@tiptap/extension-table": "2.27.3",
    "@tiptap/extension-table-cell": "2.27.3",
    "@tiptap/extension-table-header": "2.27.3",
    "@tiptap/extension-table-row": "2.27.3",
    "@tiptap/extension-task-item": "2.27.3",
    "@tiptap/extension-task-list": "2.27.3",
    "@tiptap/extension-text-align": "2.27.3",
    "@tiptap/extension-text-style": "2.27.3",
    "@tiptap/extension-underline": "2.27.3",
    "@tiptap/pm": "2.27.3",
    "@tiptap/starter-kit": "2.27.3",
    "@tiptap/suggestion": "2.27.3",
    "@types/node": "24.19.2",
    "@types/prismjs": "1.26.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "bootstrap": "5.3.8",
    "bootstrap-icons": "1.13.2",
    "happy-dom": "21.0.4",
    "jquery": "3.7.1",
    "oxlint": "1.91.0",
    "prismjs": "1.30.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.2",
    "vite": "8.3.6",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
